{
  "name": "reposell-listing",
  "version": "0.1.0",
  "description": "The official reposell discovery directory — registry, verification CI, and discovery payments",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "docs:dev": "npm run registry:index && vitepress dev docs",
    "docs:build": "npm run registry:index && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "registry:index": "node scripts/build-listings-index.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnzoVezzaro/reposell-listing.git"
  },
  "keywords": [
    "reposell",
    "listing",
    "stripe",
    "static"
  ],
  "author": "Enzo Vezzaro",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/EnzoVezzaro/reposell-listing/issues"
  },
  "homepage": "https://github.com/EnzoVezzaro/reposell-listing#readme",
  "devDependencies": {
    "@oxlint/plugins": "^1.79.0",
    "animejs": "^4.5.0",
    "ogl": "^1.0.11",
    "oxlint": "^1.79.0",
    "typescript": "^5.0.0",
    "vitepress": "1.0.0-alpha.75",
    "vitest": "^1.0.0"
  }
}