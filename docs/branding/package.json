{
  "name": "@reposell/design-system",
  "version": "1.0.0",
  "description": "reposell Design System - Shared UI components, tokens, and VitePress theme",
  "type": "module",
  "main": "./tokens/index.ts",
  "types": "./tokens/index.ts",
  "exports": {
